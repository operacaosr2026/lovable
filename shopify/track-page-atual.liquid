</style>



<script>
(function () {

  var TRACK_API =
    "https://lojas-one.vercel.app/api/public/track";

  var RECENT_API =
    "https://lojas-one.vercel.app/api/public/recent-deliveries";


  var searchScreen =
    document.getElementById("vt-search-screen");

  var resultScreen =
    document.getElementById("vt-result-screen");

  var loading =
    document.getElementById("vt-loading");

  var errorBox =
    document.getElementById("vt-error");

  var codeInput =
    document.getElementById("vt-code");

  var orderInput =
    document.getElementById("vt-order");

  var contactInput =
    document.getElementById("vt-contact");


  var STATUS = {

    NotFound: {
      label: "Order Placed",
      step: 1
    },

    InfoReceived: {
      label: "Order Placed",
      step: 1
    },

    InTransit: {
      label: "In Transit",
      step: 2
    },

    Exception: {
      label: "In Transit",
      step: 2
    },

    Expired: {
      label: "In Transit",
      step: 2
    },

    AvailableForPickup: {
      label: "Ready for Pickup",
      step: 3
    },

    OutForDelivery: {
      label: "Out for Delivery",
      step: 3
    },

    DeliveryFailure: {
      label: "Delivery Attempted",
      step: 3
    },

    Delivered: {
      label: "Delivered",
      step: 4
    }

  };


  function showError(message) {

    errorBox.textContent = message;

    errorBox.style.display = "block";

  }


  function clearError() {

    errorBox.textContent = "";

    errorBox.style.display = "none";

  }


  function showLoading() {

    clearError();

    searchScreen.hidden = true;

    resultScreen.hidden = true;

    loading.hidden = false;

  }


  function showSearch() {

    loading.hidden = true;

    resultScreen.hidden = true;

    searchScreen.hidden = false;

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  function normalizeTracking(data) {

    if (data && data.tracking) {
      return data.tracking;
    }

    if (
      data &&
      data.data &&
      data.data.tracking
    ) {
      return data.data.tracking;
    }

    if (data && data.data) {
      return data.data;
    }

    return data || {};

  }


  function getEventDateValue(event) {

    return (
      event.datetime ||
      event.date ||
      event.time ||
      event.timestamp ||
      event.created_at ||
      event.createdAt ||
      ""
    );

  }


  function formatEventDate(value) {

    if (!value) {
      return {
        date: "",
        time: ""
      };
    }

    var parsed =
      new Date(value);

    if (isNaN(parsed.getTime())) {

      return {
        date: String(value),
        time: ""
      };

    }

    return {

      date: parsed.toLocaleDateString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric"
        }
      ),

      time: parsed.toLocaleTimeString(
        "en-US",
        {
          hour: "numeric",
          minute: "2-digit"
        }
      )

    };

  }


  function formatShortDate(value) {

    if (!value) {
      return "";
    }

    var parsed =
      new Date(value);

    if (isNaN(parsed.getTime())) {
      return "";
    }

    return parsed.toLocaleDateString(
      "en-US",
      {
        month: "short",
        day: "numeric",
        year: "numeric"
      }
    );

  }


  function relativeTime(value) {

    if (!value) {
      return "";
    }

    var parsed =
      new Date(value);

    if (isNaN(parsed.getTime())) {
      return "";
    }

    var difference =
      Date.now() - parsed.getTime();

    var minutes =
      Math.floor(difference / 60000);

    if (minutes < 1) {
      return "just now";
    }

    if (minutes < 60) {
      return minutes + " min ago";
    }

    var hours =
      Math.floor(minutes / 60);

    if (hours < 24) {

      if (hours === 1) {
        return "1 hour ago";
      }

      return hours + " hours ago";

    }

    var days =
      Math.floor(hours / 24);

    if (days === 1) {
      return "1 day ago";
    }

    return days + " days ago";

  }


  function getDescription(event) {

    return (
      event.description ||
      event.details ||
      event.message ||
      ""
    );

  }


  function getEventTitle(event) {

    return (
      event.status ||
      event.title ||
      event.event ||
      event.description ||
      event.message ||
      "Shipment update"
    );

  }


  function getLocation(event) {

    if (event.location) {
      return event.location;
    }

    var pieces = [];

    if (event.city) {
      pieces.push(event.city);
    }

    if (event.region) {
      pieces.push(event.region);
    }

    if (event.country) {
      pieces.push(event.country);
    }

    return pieces.join(", ");

  }


  function escapeHTML(value) {

    var element =
      document.createElement("div");

    element.textContent =
      value === null ||
      value === undefined
        ? ""
        : String(value);

    return element.innerHTML;

  }


  /* =========================
     ORDER ACCORDION
  ========================== */

  document
    .getElementById("vt-order-toggle")
    .addEventListener(
      "click",
      function () {

        var isOpen =
          this.getAttribute("aria-expanded") === "true";

        this.setAttribute(
          "aria-expanded",
          isOpen ? "false" : "true"
        );

        document
          .getElementById("vt-order-panel")
          .classList
          .toggle(
            "open",
            !isOpen
          );

      }
    );


  /* =========================
     TRACK BY CODE
  ========================== */

  async function trackCode() {

    var code =
      codeInput.value.trim();

    if (!code) {

      showError(
        "Please enter your tracking number."
      );

      return;

    }

    showLoading();

    try {

      var response =
        await fetch(
          TRACK_API +
          "?code=" +
          encodeURIComponent(code),
          {
            method: "GET",

            headers: {
              Accept: "application/json"
            }
          }
        );

      var data =
        await response.json();

      if (!response.ok) {

        throw new Error(
          data.message ||
          data.error ||
          "We couldn't find this tracking number."
        );

      }

      renderTracking(data);

    } catch (error) {

      loading.hidden = true;

      searchScreen.hidden = false;

      showError(
        error.message ||
        "We couldn't load your tracking information."
      );

    }

  }


  /* =========================
     TRACK BY ORDER
  ========================== */

  async function trackOrder() {

    var order =
      orderInput.value.trim();

    var contact =
      contactInput.value.trim();

    if (!order || !contact) {

      showError(
        "Please enter your order number and email or phone number."
      );

      return;

    }

    showLoading();

    try {

      var response =
        await fetch(
          TRACK_API,
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
              Accept: "application/json"
            },

            body: JSON.stringify({
              order: order,
              contact: contact
            })
          }
        );

      var data =
        await response.json();

      if (!response.ok) {

        throw new Error(
          data.message ||
          data.error ||
          "We couldn't find your order."
        );

      }

      renderTracking(data);

    } catch (error) {

      loading.hidden = true;

      searchScreen.hidden = false;

      showError(
        error.message ||
        "We couldn't load your order."
      );

    }

  }


  /* =========================
     RESULT
  ========================== */

  function renderTracking(data) {

    var tracking =
      normalizeTracking(data);

    loading.hidden = true;


    if (
      !tracking ||
      (
        !tracking.status &&
        !tracking.events &&
        !tracking.tracking_number &&
        !tracking.trackingNumber &&
        !tracking.code
      )
    ) {

      searchScreen.hidden = false;

      showError(
        "We couldn't find tracking information for this order."
      );

      return;

    }


    var rawStatus =
      tracking.status ||
      tracking.status_code ||
      tracking.statusCode ||
      "InTransit";


    var status =
      STATUS[rawStatus] ||
      {
        label: rawStatus || "In Transit",
        step: 2
      };


    var events =
      Array.isArray(tracking.events)
        ? tracking.events
        : [];


    /* ORDER REFERENCE */

    var orderReference =
      tracking.order_number ||
      tracking.orderNumber ||
      tracking.order ||
      tracking.order_name ||
      tracking.orderName ||
      "";

    var referenceElement =
      document.getElementById(
        "vt-order-reference"
      );

    if (orderReference) {

      var orderText =
        String(orderReference);

      if (
        orderText.charAt(0) !== "#"
      ) {
        orderText =
          "#" + orderText;
      }

      referenceElement.textContent =
        "Order " + orderText;

    } else {

      referenceElement.textContent = "";

    }


    /* STATUS TITLE */

    document
      .getElementById("vt-result-title")
      .textContent =
        status.label;


    /* SUBTITLE */

    var subtitle =
      "Your order is on the way.";

    if (rawStatus === "Delivered") {

      subtitle =
        "Your order has been delivered.";

    } else if (
      rawStatus === "OutForDelivery"
    ) {

      subtitle =
        "Your order is on the way and will be delivered soon.";

    } else if (
      rawStatus === "AvailableForPickup"
    ) {

      subtitle =
        "Your order is ready for pickup.";

    } else if (
      rawStatus === "DeliveryFailure"
    ) {

      subtitle =
        "A delivery attempt was made.";

    } else if (
      rawStatus === "InfoReceived" ||
      rawStatus === "NotFound"
    ) {

      subtitle =
        "Your order has been prepared for shipment.";

    } else if (
      tracking.description ||
      tracking.status_description
    ) {

      subtitle =
        tracking.description ||
        tracking.status_description;

    }


    document
      .getElementById("vt-result-subtitle")
      .textContent =
        subtitle;


    /* EDD */

    var eddElement =
      document.getElementById("vt-result-edd");

    if (
      tracking.edd &&
      rawStatus !== "Delivered"
    ) {

      eddElement.textContent =
        "Estimated delivery: " +
        tracking.edd;

      eddElement.hidden = false;

    } else {

      eddElement.textContent = "";

      eddElement.hidden = true;

    }


    /* TRACKING NUMBER */

    var trackingNumber =
      tracking.tracking_number ||
      tracking.trackingNumber ||
      tracking.code ||
      "";

    document
      .getElementById("vt-tracking-number")
      .textContent =
        trackingNumber
          ? "Tracking: " + trackingNumber
          : "";


    setProgress(
      status.step,
      events
    );

    renderTimeline(events);


    searchScreen.hidden = true;

    resultScreen.hidden = false;


    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  /* =========================
     PROGRESS
  ========================== */

  function setProgress(
    currentStep,
    events
  ) {

    var items =
      document.querySelectorAll(
        "#vt-track .vt-progress-item"
      );


    for (
      var i = 0;
      i < items.length;
      i++
    ) {

      var step =
        Number(
          items[i].getAttribute(
            "data-step"
          )
        );

      items[i].classList.remove(
        "vt-done",
        "vt-current"
      );


      if (step < currentStep) {

        items[i].classList.add(
          "vt-done"
        );

      } else if (
        step === currentStep
      ) {

        items[i].classList.add(
          "vt-current"
        );

      }

    }


    setStepDates(events);

  }


  function setStepDates(events) {

    var step1 =
      document.getElementById(
        "vt-step-date-1"
      );

    var step2 =
      document.getElementById(
        "vt-step-date-2"
      );

    var step3 =
      document.getElementById(
        "vt-step-date-3"
      );

    var step4 =
      document.getElementById(
        "vt-step-date-4"
      );


    step1.textContent = "";
    step2.textContent = "";
    step3.textContent = "";
    step4.textContent = "";


    if (!events.length) {
      return;
    }


    for (
      var i = events.length - 1;
      i >= 0;
      i--
    ) {

      var event =
        events[i];

      var text =
        (
          getEventTitle(event) +
          " " +
          getDescription(event)
        ).toLowerCase();

      var date =
        formatShortDate(
          getEventDateValue(event)
        );


      if (
        !step1.textContent &&
        (
          text.indexOf("processed") !== -1 ||
          text.indexOf("information received") !== -1 ||
          text.indexOf("order ready") !== -1 ||
          text.indexOf("shipment information") !== -1
        )
      ) {

        step1.textContent = date;

      }


      if (
        !step2.textContent &&
        (
          text.indexOf("transit") !== -1 ||
          text.indexOf("departed") !== -1 ||
          text.indexOf("facility") !== -1
        )
      ) {

        step2.textContent = date;

      }


      if (
        !step3.textContent &&
        text.indexOf("out for delivery") !== -1
      ) {

        step3.textContent = date;

      }


      if (
        !step4.textContent &&
        text.indexOf("delivered") !== -1 &&
        text.indexOf("out for delivery") === -1
      ) {

        step4.textContent = date;

      }

    }

  }


  /* =========================
     TIMELINE
  ========================== */

  function renderTimeline(events) {

    var timeline =
      document.getElementById(
        "vt-timeline"
      );

    timeline.innerHTML = "";


    if (!events.length) {

      timeline.innerHTML =
        '<div style="padding:24px 0;color:#888;font-size:11px;">Tracking updates will appear here as your package moves.</div>';

      return;

    }


    for (
      var i = 0;
      i < events.length;
      i++
    ) {

      var event =
        events[i];


      var title =
        getEventTitle(event);


      var location =
        getLocation(event);


      var description =
        getDescription(event);


      /*
       If description is identical to title,
       don't repeat the same text.
      */

      if (
        description &&
        title &&
        String(description).trim().toLowerCase() ===
        String(title).trim().toLowerCase()
      ) {

        description = "";

      }


      var formattedDate =
        formatEventDate(
          getEventDateValue(event)
        );


      var item =
        document.createElement("div");

      item.className =
        "vt-event";


      var html =
        '<div class="vt-event-date">' +

          (
            formattedDate.date
              ? '<strong>' +
                  escapeHTML(
                    formattedDate.date
                  ) +
                '</strong>'
              : ''
          ) +

          (
            formattedDate.time
              ? '<span>' +
                  escapeHTML(
                    formattedDate.time
                  ) +
                '</span>'
              : ''
          ) +

        '</div>' +

        '<div class="vt-event-marker">' +
          '<span class="vt-event-dot"></span>' +
        '</div>' +

        '<div class="vt-event-content">' +

          '<div class="vt-event-title">' +
            escapeHTML(title) +
          '</div>';


      if (location) {

        html +=
          '<div class="vt-event-location">' +

            '<svg viewBox="0 0 24 24" aria-hidden="true">' +
              '<path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>' +
              '<circle cx="12" cy="10" r="2.5"></circle>' +
            '</svg>' +

            '<span>' +
              escapeHTML(location) +
            '</span>' +

          '</div>';

      }


      if (description) {

        html +=
          '<div class="vt-event-description">' +
            escapeHTML(description) +
          '</div>';

      }


      html +=
        '</div>';


      item.innerHTML =
        html;


      timeline.appendChild(
        item
      );

    }

  }


  /* =========================
     RECENT DELIVERIES
  ========================== */

  var recentDeliveries = [];

  var recentPosition = 0;

  var recentRotationTimer = null;


  function renderRecent() {

    var section =
      document.getElementById(
        "vt-recent"
      );

    var list =
      document.getElementById(
        "vt-recent-list"
      );


    if (!recentDeliveries.length) {

      section.hidden = true;

      return;

    }


    list.innerHTML = "";


    var visibleCount =
      Math.min(
        6,
        recentDeliveries.length
      );


    for (
      var i = 0;
      i < visibleCount;
      i++
    ) {

      var index =
        (
          recentPosition + i
        ) %
        recentDeliveries.length;


      var delivery =
        recentDeliveries[index];


      if (
        !delivery ||
        !delivery.city ||
        !delivery.status
      ) {

        continue;

      }


      var item =
        document.createElement("div");

      item.className =
        "vt-recent-item";


      var location =
        document.createElement("div");

      location.className =
        "vt-recent-location";


      /*
       STATE BADGE

       This intentionally does NOT load an external
       image, so there is no broken-image icon.
      */

      var state =
        document.createElement("span");

      state.className =
        "vt-state-badge";

      state.textContent =
        delivery.region
          ? String(
              delivery.region
            ).toUpperCase()
          : "US";


      var city =
        document.createElement("span");

      city.className =
        "vt-recent-city";

      city.textContent =
        delivery.city +
        (
          delivery.region
            ? ", " + delivery.region
            : ""
        );


      location.appendChild(state);

      location.appendChild(city);


      var bottom =
        document.createElement("div");

      bottom.className =
        "vt-recent-bottom";


      var status =
        document.createElement("span");

      status.className =
        "vt-recent-status";

      status.textContent =
        delivery.status;


      bottom.appendChild(status);


      if (delivery.at) {

        var time =
          document.createElement("span");

        time.className =
          "vt-recent-time";

        time.textContent =
          relativeTime(
            delivery.at
          );

        bottom.appendChild(time);

      }


      item.appendChild(location);

      item.appendChild(bottom);

      list.appendChild(item);

    }


    section.hidden =
      list.children.length === 0;

  }


  function startRecentRotation() {

    if (recentRotationTimer) {

      clearInterval(
        recentRotationTimer
      );

      recentRotationTimer = null;

    }


    if (
      recentDeliveries.length <= 6
    ) {
      return;
    }


    recentRotationTimer =
      setInterval(
        function () {

          recentPosition += 6;


          if (
            recentPosition >=
            recentDeliveries.length
          ) {

            recentPosition = 0;

          }


          renderRecent();

        },
        5000
      );

  }


  async function loadRecentDeliveries() {

    try {

      var response =
        await fetch(
          RECENT_API,
          {
            method: "GET",

            headers: {
              Accept: "application/json"
            },

            cache: "no-store"
          }
        );


      if (!response.ok) {
        return;
      }


      var data =
        await response.json();


      var deliveries = [];


      if (
        Array.isArray(data)
      ) {

        deliveries =
          data;

      } else if (
        data &&
        Array.isArray(
          data.deliveries
        )
      ) {

        deliveries =
          data.deliveries;

      } else if (
        data &&
        data.data &&
        Array.isArray(
          data.data.deliveries
        )
      ) {

        deliveries =
          data.data.deliveries;

      }


      recentDeliveries =
        deliveries.filter(
          function (delivery) {

            return (
              delivery &&
              delivery.city &&
              delivery.status
            );

          }
        );


      recentPosition = 0;


      renderRecent();

      startRecentRotation();

    } catch (error) {

      document
        .getElementById("vt-recent")
        .hidden = true;

    }

  }


  /* =========================
     BUTTON EVENTS
  ========================== */

  document
    .getElementById("vt-track-btn")
    .addEventListener(
      "click",
      trackCode
    );


  document
    .getElementById("vt-order-btn")
    .addEventListener(
      "click",
      trackOrder
    );


  document
    .getElementById("vt-back")
    .addEventListener(
      "click",
      showSearch
    );


  codeInput.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Enter"
      ) {

        trackCode();

      }

    }
  );


  contactInput.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Enter"
      ) {

        trackOrder();

      }

    }
  );


  /* =========================
     URL AUTO TRACK
  ========================== */

  var params =
    new URLSearchParams(
      window.location.search
    );


  var automaticCode =
    params.get("code") ||
    params.get("tracking") ||
    params.get("nums");


  if (automaticCode) {

    codeInput.value =
      automaticCode;

    trackCode();

  }


  /* =========================
     INIT
  ========================== */

  loadRecentDeliveries();


  setInterval(
    loadRecentDeliveries,
    60000
  );

})();
