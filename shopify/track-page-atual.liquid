}

.vt-benefit-icon {
  display: grid;

  place-items: center;

  flex: 0 0 33px;

  width: 33px;
  height: 33px;

  border-radius: 50%;

  background: #f5f4f1;
}

.vt-benefit-icon svg {
  width: 16px;
  height: 16px;

  fill: none;

  stroke: #444;

  stroke-width: 1.5;
}

.vt-benefit strong,
.vt-benefit small {
  display: block;
}

.vt-benefit strong {
  font-size: 11px;
}

.vt-benefit small {
  margin-top: 2px;

  color: #929292;

  font-size: 9px;
}


/* =========================
