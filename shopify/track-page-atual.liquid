<style>

#vt-track,
#vt-track * {
  box-sizing: border-box;
}

#vt-track {
  --vt-black: #17191c;
  --vt-text: #1b1d20;
  --vt-muted: #8d9198;
  --vt-line: #e7e7e5;
  --vt-soft: #f6f6f4;
  --vt-green: #20ae4b;
  --vt-green-soft: #e8f8ec;

  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 24px 40px;

  color: var(--vt-text);
  font-family: inherit;
}

#vt-track [hidden] {
  display: none !important;
}

#vt-track button,
#vt-track input {
  font: inherit;
}

#vt-track button {
  cursor: pointer;
}


/* =========================
   SEARCH TITLE
========================= */

.vt-heading {
  text-align: center;
  margin: 0 0 8px;
}

.vt-heading h1 {
  margin: 0;

  font-size: clamp(27px, 3vw, 34px);
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -1.4px;
}

.vt-heading p {
  margin: 5px 0 0;

  color: #96999e;

  font-size: 13px;
}


/* =========================
   SEARCH HERO
========================= */

.vt-hero {
  display: grid;

  grid-template-columns:
    minmax(360px, 440px)
    minmax(430px, 1fr);

  align-items: center;

  gap: 70px;

  max-width: 1040px;

  min-height: 250px;

  margin: 0 auto;
}


/* =========================
   SEARCH CARD
========================= */

.vt-search-card {
  padding: 21px 24px 17px;

  border: 1px solid #e5e4e1;

  border-radius: 18px;

  background: #fff;
}

.vt-search-card label {
  display: block;

  margin-bottom: 7px;

  color: #25272b;

  font-size: 12px;

  font-weight: 500;
}

.vt-input-wrap {
  position: relative;
}

.vt-input-wrap svg {
  position: absolute;

  top: 50%;
  left: 15px;

  width: 18px;
  height: 18px;

  transform: translateY(-50%);

  fill: none;

  stroke: #8a8e94;

  stroke-width: 1.5;
}

#vt-track input {
  width: 100%;

  height: 47px;

  padding: 0 14px;

  border: 1px solid #dcdcdc;

  border-radius: 10px;

  background: #fff;

  color: #222;

  outline: none;
}

.vt-input-wrap input {
  padding-left: 43px !important;
}

#vt-track input:focus {
  border-color: #999;
}


/* =========================
   SEARCH BUTTON
========================= */

.vt-primary,
.vt-secondary {
  width: 100%;

  height: 47px;

  border: 0;

  border-radius: 10px;

  background: #18191c;

  color: #fff;

  font-weight: 500;
}

.vt-primary {
  margin-top: 10px;

  font-size: 14px;
}

.vt-primary span {
  margin-left: 8px;
}

.vt-secondary {
  margin-top: 10px;
}


/* =========================
   DIVIDER
========================= */

.vt-divider {
  display: flex;

  align-items: center;

  gap: 12px;

  margin: 12px 0 3px;

  color: #aaa;

  font-size: 10px;
}

.vt-divider:before,
.vt-divider:after {
  content: "";

  flex: 1;

  height: 1px;

  background: #e6e5e2;
}


/* =========================
   ORDER TOGGLE
========================= */

.vt-order-toggle {
  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  padding: 8px 2px 3px;

  border: 0;

  background: transparent;

  color: #333;
}

.vt-order-toggle > span {
  display: flex;

  align-items: center;

  gap: 8px;

  font-size: 11px;

  font-weight: 500;
}

.vt-order-toggle svg {
  width: 16px;
  height: 16px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.7;
}

.vt-chevron {
  transition: transform .2s ease;
}

.vt-order-toggle[aria-expanded="true"] .vt-chevron {
  transform: rotate(180deg);
}

.vt-order-panel {
  display: grid;

  grid-template-rows: 0fr;

  transition: grid-template-rows .25s ease;
}

.vt-order-panel.open {
  grid-template-rows: 1fr;
}

.vt-order-inner {
  overflow: hidden;
}

.vt-order-panel.open .vt-order-inner {
  padding-top: 10px;
}

.vt-order-inner label:not(:first-child) {
  margin-top: 10px;
}


/* =========================
   ERROR
========================= */

.vt-error {
  display: none;

  margin-top: 10px;

  padding: 9px 11px;

  border-radius: 8px;

  background: #fff1f0;

  color: #9b302b;

  font-size: 11px;
}


/* =========================
   BOX
========================= */

.vt-visual {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  min-height: 245px;
}

.vt-box {
  position: relative;

  z-index: 2;

  display: block;

  width: min(100%, 405px);

  height: auto;

  filter: drop-shadow(0 18px 18px rgba(0,0,0,.06));
}


/* =========================
   FLOATING CARD
========================= */

.vt-floating {
  position: absolute;

  z-index: 5;

  top: 5px;
  right: 34px;

  display: flex;

  align-items: center;

  gap: 9px;

  padding: 9px 13px;

  border: 1px solid #e5e4e1;

  border-radius: 12px;

  background: rgba(255,255,255,.98);

  box-shadow: 0 8px 24px rgba(0,0,0,.05);
}

.vt-floating-icon {
  display: grid;

  place-items: center;

  width: 31px;
  height: 31px;

  flex: 0 0 31px;

  border-radius: 50%;

  background: #f3f2ef;
}

.vt-floating-icon svg {
  width: 16px;
  height: 16px;

  fill: none;

  stroke: #333;

  stroke-width: 1.6;
}

.vt-floating strong,
.vt-floating small {
  display: block;
}

.vt-floating strong {
  font-size: 11px;
}

.vt-floating small {
  margin-top: 2px;

  color: #999;

  font-size: 9px;
}


/* =========================
   BENEFITS
========================= */

.vt-benefits {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  max-width: 1040px;

  margin: 2px auto 0;

  padding: 12px 0;

  border-top: 1px solid #e5e5e3;

  border-bottom: 1px solid #e5e5e3;
}

.vt-benefit {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  padding: 0 18px;
}

