  display: flex;

  align-items: center;

  height: 38px;
}

.vt-progress-circle {
  position: relative;

  z-index: 2;

  display: grid;

  place-items: center;

  width: 31px;
  height: 31px;

  flex: 0 0 31px;

  margin: 0 auto;

  border-radius: 50%;

  background: #c8c9cb;

  color: #fff;

  transition: all .2s ease;
}

.vt-progress-circle svg {
  width: 16px;
