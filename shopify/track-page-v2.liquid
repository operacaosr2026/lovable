<!--
  Página de rastreio da Voultie (v2) — Shopify > Custom Liquid.
  APIs (não mudam): /api/public/track (GET ?code= | POST { orderNumber, contact })
  e /api/public/recent-deliveries. Os dados já chegam filtrados (sem China/
  alfândega, sem dados pessoais). Aceita ?nums=CÓDIGO (link dos e-mails).
  Nunca inventa evento, data, local ou descrição — mostra só o que a API manda.
-->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<div id="vt-track">

  <!-- ========================= SEARCH SCREEN ========================= -->
  <section id="vt-search-screen">

    <div class="vt-heading">
      <h1>Track Your Order</h1>
      <p>Get the latest updates on your delivery.</p>
    </div>

    <div class="vt-hero">

      <div class="vt-search-card">
        <label for="vt-code">Tracking number</label>
        <div class="vt-input-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6.5 12 2l9 4.5v11L12 22l-9-4.5v-11Z"></path>
            <path d="M3 6.5 12 11l9-4.5M12 11v11"></path>
          </svg>
          <input id="vt-code" type="text" placeholder="Enter your tracking number" autocomplete="off">
        </div>

        <button id="vt-track-btn" class="vt-primary" type="button">Track Order <span>→</span></button>

        <div class="vt-divider"><span>or</span></div>

        <button id="vt-order-toggle" class="vt-order-toggle" type="button" aria-expanded="false">
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16"></rect>
              <path d="M8 9h8M8 13h5"></path>
            </svg>
            Track with order number
          </span>
          <svg class="vt-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>

        <div id="vt-order-panel" class="vt-order-panel">
          <div class="vt-order-inner">
            <label for="vt-order">Order number</label>
            <input id="vt-order" type="text" placeholder="e.g. 1234 or #1234" autocomplete="off">
            <label for="vt-contact">Email or phone number</label>
            <input id="vt-contact" type="text" placeholder="Email or phone used on your order" autocomplete="off">
            <button id="vt-order-btn" class="vt-secondary" type="button">Find My Order</button>
          </div>
        </div>

        <div id="vt-error" class="vt-error"></div>
      </div>

      <div class="vt-visual">
        <img class="vt-box" src="https://cdn.shopify.com/s/files/1/0827/5646/8973/files/Caixa_Voultie_com_Etiqueta_de_Envio.png?v=1791255929" alt="Voultie shipping box">
        <div class="vt-floating">
          <span class="vt-floating-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 7h11v10H3z"></path>
              <path d="M14 10h4l3 3v4h-7z"></path>
              <circle cx="7" cy="18" r="1.8"></circle>
              <circle cx="18" cy="18" r="1.8"></circle>
            </svg>
          </span>
          <div>
            <strong>On the way</strong>
            <small>Your order is in transit</small>
          </div>
        </div>
      </div>

    </div>

    <div class="vt-benefits">
      <div class="vt-benefit">
        <span class="vt-benefit-icon"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 2.8 7.9 7 10 4.2-2.1 7-5.5 7-10V6l-7-3Z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
        <div><strong>Secure Tracking</strong><small>Your information is safe with us.</small></div>
      </div>
      <div class="vt-benefit">
        <span class="vt-benefit-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><path d="M12 8v5l3 2"></path></svg></span>
        <div><strong>Updates in Real Time</strong><small>Get the latest delivery status.</small></div>
      </div>
      <div class="vt-benefit">
        <span class="vt-benefit-icon"><svg viewBox="0 0 24 24"><path d="M4 7 12 3l8 4v10l-8 4-8-4V7Z"></path><path d="m4 7 8 4 8-4M12 11v10"></path></svg></span>
        <div><strong>Questions?</strong><small>Visit our FAQ or contact us.</small></div>
      </div>
    </div>

    <section id="vt-recent" class="vt-recent" hidden>
      <div class="vt-recent-head">
        <div class="vt-recent-heading">
          <span class="vt-recent-main-dot"></span>
          <div>
            <h2>Recent Deliveries</h2>
            <p>Real orders, real deliveries. Updated automatically.</p>
          </div>
        </div>
        <div class="vt-live"><span></span>Live updates</div>
      </div>
      <div id="vt-recent-list" class="vt-recent-list"></div>
    </section>

  </section>

  <!-- ========================= RESULT SCREEN ========================= -->
  <section id="vt-result-screen" class="vt-result-screen" hidden>

    <button id="vt-back" class="vt-back" type="button"><span>←</span> Track another order</button>

    <div class="vt-result-hero">
      <div id="vt-order-reference" class="vt-order-reference"></div>
      <div class="vt-result-status-row">
        <div class="vt-result-status-icon">
          <svg viewBox="0 0 24 24">
            <path d="M3 7h11v10H3z"></path>
            <path d="M14 10h4l3 3v4h-7z"></path>
            <circle cx="7" cy="18" r="1.7"></circle>
            <circle cx="18" cy="18" r="1.7"></circle>
          </svg>
        </div>
        <div class="vt-result-status-copy">
          <h1 id="vt-result-title">In Transit</h1>
          <p id="vt-result-subtitle">Your order is on the way.</p>
        </div>
      </div>
      <div id="vt-result-edd" class="vt-result-edd" hidden></div>
    </div>

    <div class="vt-order-progress">
      <div class="vt-progress-item" data-step="1">
        <div class="vt-progress-track">
          <div class="vt-progress-circle"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"></path></svg></div>
          <div class="vt-progress-line"></div>
        </div>
        <div class="vt-progress-label"><strong>Order Placed</strong><span id="vt-step-date-1"></span></div>
      </div>
      <div class="vt-progress-item" data-step="2">
        <div class="vt-progress-track">
          <div class="vt-progress-circle"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"></path></svg></div>
          <div class="vt-progress-line"></div>
        </div>
        <div class="vt-progress-label"><strong>In Transit</strong><span id="vt-step-date-2"></span></div>
      </div>
      <div class="vt-progress-item" data-step="3">
        <div class="vt-progress-track">
          <div class="vt-progress-circle vt-truck-circle">
            <svg class="vt-check-icon" viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"></path></svg>
            <svg class="vt-truck-icon" viewBox="0 0 24 24">
              <path d="M3 7h11v10H3z"></path>
              <path d="M14 10h4l3 3v4h-7z"></path>
              <circle cx="7" cy="18" r="1.6"></circle>
              <circle cx="18" cy="18" r="1.6"></circle>
            </svg>
          </div>
          <div class="vt-progress-line"></div>
        </div>
        <div class="vt-progress-label"><strong>Out for Delivery</strong><span id="vt-step-date-3"></span></div>
      </div>
      <div class="vt-progress-item" data-step="4">
        <div class="vt-progress-track">
          <div class="vt-progress-circle"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"></path></svg></div>
        </div>
        <div class="vt-progress-label"><strong>Delivered</strong><span id="vt-step-date-4"></span></div>
      </div>
    </div>

    <div class="vt-tracking-card">
      <div class="vt-tracking-head">
        <h2>Tracking Details</h2>
        <span id="vt-tracking-number"></span>
      </div>
      <div id="vt-timeline" class="vt-timeline"></div>
      <button id="vt-timeline-more" class="vt-timeline-more" type="button" hidden></button>
    </div>

    <div class="vt-support-card">
      <div class="vt-support-left">
        <div class="vt-support-icon">
          <svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.6 9.6 0 0 1-4-.9L3 21l1.7-4.5A8.2 8.2 0 0 1 3 11.5 8.6 8.6 0 0 1 12 3a8.6 8.6 0 0 1 9 8.5Z"></path></svg>
        </div>
        <div>
          <strong>Need help with your order?</strong>
          <span>Our support team is here to help.</span>
        </div>
      </div>
      <a class="vt-support-button" href="/pages/contact">Contact Support <span>→</span></a>
    </div>

  </section>

  <!-- ========================= LOADING ========================= -->
  <div id="vt-loading" class="vt-loading" hidden>
    <span class="vt-spinner"></span>
    <strong>Finding your order...</strong>
    <small>Getting the latest delivery updates</small>
  </div>

</div>

<style>
#vt-track, #vt-track * { box-sizing: border-box; }
#vt-track {
  --vt-black: #17191c; --vt-text: #1b1d20; --vt-muted: #8d9198; --vt-line: #e7e7e5;
  --vt-soft: #f6f6f4; --vt-green: #20ae4b; --vt-green-soft: #e8f8ec;
  width: 100%; max-width: 1280px; margin: 0 auto; padding: 6px 24px 40px;
  color: var(--vt-text); font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; letter-spacing: normal;
}
#vt-track [hidden] { display: none !important; }
/* O tema esconde div vazio (div:empty { display: none }) — sem isso somem as linhas das etapas e as bolinhas. */
#vt-track .vt-progress-line, #vt-track .vt-event-dot, #vt-track .vt-recent-main-dot { display: block !important; }
#vt-track button, #vt-track input { font: inherit; }
#vt-track button { cursor: pointer; }

/* SEARCH TITLE */
#vt-track .vt-heading { text-align: center; margin: 0 0 8px; }
#vt-track .vt-heading h1 { margin: 0; font-size: clamp(27px, 3vw, 34px); font-weight: 600; line-height: 1.05; letter-spacing: -1.4px; }
#vt-track .vt-heading p { margin: 5px 0 0; color: #96999e; font-size: 13px; }

/* SEARCH HERO */
#vt-track .vt-hero { display: grid; grid-template-columns: minmax(360px, 440px) minmax(430px, 1fr); align-items: center; gap: 70px; max-width: 1040px; min-height: 250px; margin: 0 auto; }

/* SEARCH CARD */
#vt-track .vt-search-card { padding: 21px 24px 17px; border: 1px solid #e5e4e1; border-radius: 18px; background: #fff; }
#vt-track .vt-search-card label { display: block; margin-bottom: 7px; color: #25272b; font-size: 12px; font-weight: 500; }
#vt-track .vt-input-wrap { position: relative; }
#vt-track .vt-input-wrap svg { position: absolute; top: 50%; left: 15px; width: 18px; height: 18px; transform: translateY(-50%); fill: none; stroke: #8a8e94; stroke-width: 1.5; }
#vt-track input { width: 100%; height: 47px; padding: 0 14px; border: 1px solid #dcdcdc; border-radius: 10px; background: #fff; color: #222; outline: none; }
#vt-track .vt-input-wrap input { padding-left: 43px !important; }
#vt-track input:focus { border-color: #999; }

/* BUTTONS */
#vt-track .vt-primary, #vt-track .vt-secondary { width: 100%; height: 47px; border: 0; border-radius: 10px; background: #18191c; color: #fff; font-weight: 500; }
#vt-track .vt-primary { margin-top: 10px; font-size: 14px; }
#vt-track .vt-primary span { margin-left: 8px; }
#vt-track .vt-secondary { margin-top: 10px; }

/* DIVIDER */
#vt-track .vt-divider { display: flex; align-items: center; gap: 12px; margin: 12px 0 3px; color: #aaa; font-size: 10px; }
#vt-track .vt-divider:before, #vt-track .vt-divider:after { content: ""; flex: 1; height: 1px; background: #e6e5e2; }

/* ORDER TOGGLE */
#vt-track .vt-order-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 8px 2px 3px; border: 0; background: transparent; color: #333; }
#vt-track .vt-order-toggle > span { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 500; }
#vt-track .vt-order-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; }
#vt-track .vt-chevron { transition: transform .2s ease; }
#vt-track .vt-order-toggle[aria-expanded="true"] .vt-chevron { transform: rotate(180deg); }
#vt-track .vt-order-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease; }
#vt-track .vt-order-panel.open { grid-template-rows: 1fr; }
#vt-track .vt-order-inner { overflow: hidden; }
#vt-track .vt-order-panel.open .vt-order-inner { padding-top: 10px; }
#vt-track .vt-order-inner label:not(:first-child) { margin-top: 10px; }

/* ERROR */
#vt-track .vt-error { display: none; margin-top: 10px; padding: 9px 11px; border-radius: 8px; background: #fff1f0; color: #9b302b; font-size: 11px; }

/* BOX */
#vt-track .vt-visual { position: relative; display: flex; align-items: center; justify-content: center; min-height: 245px; }
#vt-track .vt-box { position: relative; z-index: 2; display: block; width: min(100%, 405px); height: auto; filter: drop-shadow(0 18px 18px rgba(0,0,0,.06)); }

/* FLOATING CARD */
#vt-track .vt-floating { position: absolute; z-index: 5; top: 5px; right: 34px; display: flex; align-items: center; gap: 9px; padding: 9px 13px; border: 1px solid #e5e4e1; border-radius: 12px; background: rgba(255,255,255,.98); box-shadow: 0 8px 24px rgba(0,0,0,.05); }
#vt-track .vt-floating-icon { display: grid; place-items: center; width: 31px; height: 31px; flex: 0 0 31px; border-radius: 50%; background: #f3f2ef; }
#vt-track .vt-floating-icon svg { width: 16px; height: 16px; fill: none; stroke: #333; stroke-width: 1.6; }
#vt-track .vt-floating strong, #vt-track .vt-floating small { display: block; }
#vt-track .vt-floating strong { font-size: 11px; }
#vt-track .vt-floating small { margin-top: 2px; color: #999; font-size: 9px; }

/* BENEFITS */
#vt-track .vt-benefits { display: grid; grid-template-columns: repeat(3, 1fr); max-width: 1040px; margin: 2px auto 0; padding: 12px 0; border-top: 1px solid #e5e5e3; border-bottom: 1px solid #e5e5e3; }
#vt-track .vt-benefit { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 0 18px; }
#vt-track .vt-benefit + .vt-benefit { border-left: 1px solid #e5e5e3; }
#vt-track .vt-benefit-icon { display: grid; place-items: center; flex: 0 0 33px; width: 33px; height: 33px; border-radius: 50%; background: #f5f4f1; }
#vt-track .vt-benefit-icon svg { width: 16px; height: 16px; fill: none; stroke: #444; stroke-width: 1.5; }
#vt-track .vt-benefit strong, #vt-track .vt-benefit small { display: block; }
#vt-track .vt-benefit strong { font-size: 11px; }
#vt-track .vt-benefit small { margin-top: 2px; color: #929292; font-size: 9px; }

/* RECENT DELIVERIES */
#vt-track .vt-recent { max-width: 1180px; margin: 12px auto 0; padding: 12px 15px 13px; border: 1px solid #eceae6; border-radius: 15px; background: #fff; }
#vt-track .vt-recent-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 9px; }
#vt-track .vt-recent-heading { display: flex; align-items: flex-start; gap: 9px; }
#vt-track .vt-recent-main-dot { width: 8px; height: 8px; flex: 0 0 8px; margin-top: 4px; border-radius: 50%; background: #22b455; box-shadow: 0 0 0 5px #edf9f0; }
#vt-track .vt-recent h2 { margin: 0; font-size: 13px; font-weight: 600; }
#vt-track .vt-recent h2 + p { margin: 2px 0 0; color: #999; font-size: 9px; }
#vt-track .vt-live { display: flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; background: #edf9ef; color: #3d9a5c; font-size: 9px; }
#vt-track .vt-live > span { width: 6px; height: 6px; border-radius: 50%; background: #20b252; }
#vt-track .vt-recent-list { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: 10px; }
#vt-track .vt-recent-item { min-width: 0; min-height: 68px; padding: 9px 10px 8px; border: 1px solid #ebe9e5; border-radius: 8px; background: #fff; }
#vt-track .vt-recent-location { display: flex; align-items: center; gap: 7px; min-width: 0; }
#vt-track .vt-state-badge { display: grid; place-items: center; flex: 0 0 24px; width: 24px; height: 16px; border: 1px solid #dedede; border-radius: 3px; background: #f5f5f3; color: #555; font-size: 7px; font-weight: 700; }
#vt-track .vt-recent-city { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #505050; font-size: 10px; }
#vt-track .vt-recent-bottom { margin-top: 7px; padding-left: 31px; }
#vt-track .vt-recent-status { display: inline-block; max-width: 100%; padding: 3px 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 999px; background: #e8f8eb; color: #329452; font-size: 8px; }
#vt-track .vt-recent-time { display: block; margin-top: 5px; color: #999; font-size: 8px; }

/* RESULT PAGE */
#vt-track .vt-result-screen { width: 100%; max-width: 1040px; margin: 0 auto; padding-top: 3px; }
#vt-track .vt-back { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; padding: 2px 0; border: 0; background: transparent; color: #222; font-size: 14px; font-weight: 500; }
#vt-track .vt-back span { font-size: 18px; }

/* RESULT HERO */
#vt-track .vt-result-hero { padding: 0 0 22px; text-align: center; }
#vt-track .vt-order-reference { min-height: 18px; margin-bottom: 10px; color: #8d9197; font-size: 14px; }
#vt-track .vt-result-status-row { position: relative; display: inline-block; text-align: center; }
#vt-track .vt-result-status-icon { position: absolute; top: 50%; right: 100%; margin-right: 22px; transform: translateY(-50%); display: grid; place-items: center; width: 76px; height: 76px; flex: 0 0 76px; border-radius: 50%; background: var(--vt-green-soft); color: var(--vt-green); }
#vt-track .vt-result-status-icon svg { width: 32px; height: 32px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#vt-track .vt-result-status-copy h1 { margin: 0; color: #090a0b; font-family: inherit; font-size: clamp(32px, 4.2vw, 48px); font-weight: 800; line-height: 1.05; letter-spacing: -1.6px; text-transform: none; }
#vt-track .vt-result-status-copy { text-align: center; }
#vt-track .vt-result-status-copy p { margin: 8px 0 0; color: #8b8f95; font-size: 15px; }
#vt-track .vt-result-edd { margin-top: 12px; color: #777; font-size: 14px; }
#vt-track .vt-result-edd b { color: #222; font-weight: 600; }

/* PROGRESS */
#vt-track .vt-order-progress { display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; margin: 4px auto 30px; padding: 0; }
#vt-track .vt-progress-item { position: relative; text-align: center; }
#vt-track .vt-progress-track { position: relative; display: flex; align-items: center; height: 44px; }
#vt-track .vt-progress-circle { position: relative; z-index: 2; display: grid; place-items: center; width: 40px; height: 40px; flex: 0 0 40px; margin: 0 auto; border-radius: 50%; background: #c8c9cb; color: #fff; transition: all .2s ease; }
#vt-track .vt-progress-circle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#vt-track .vt-progress-line { position: absolute; z-index: 1; top: 50%; left: calc(50% + 24px); width: calc(100% - 48px); height: 3px; border-radius: 2px; transform: translateY(-50%); background: #d7d8da; }
#vt-track .vt-progress-item.vt-done .vt-progress-circle, #vt-track .vt-progress-item.vt-current .vt-progress-circle { background: var(--vt-green); }
#vt-track .vt-progress-item.vt-done .vt-progress-line { background: var(--vt-green); }
#vt-track .vt-progress-item.vt-current .vt-progress-line { background: #d7d8da; }
#vt-track .vt-progress-item:last-child .vt-progress-line { display: none !important; }
#vt-track .vt-progress-label { margin-top: 8px; }
#vt-track .vt-progress-label strong { display: block; color: #17191c; font-size: 14px; font-weight: 600; letter-spacing: normal; }
#vt-track .vt-progress-label span { display: block; min-height: 18px; margin-top: 4px; color: #8d9198; font-size: 13px; }
#vt-track .vt-truck-icon { display: none; }
#vt-track .vt-progress-item.vt-current[data-step="3"] .vt-check-icon { display: none; }
#vt-track .vt-progress-item.vt-current[data-step="3"] .vt-truck-icon { display: block; }

/* TRACKING CARD */
#vt-track .vt-tracking-card { width: 100%; padding: 24px 30px 10px; border: 1px solid #ececeb; border-radius: 16px; background: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.04); }
#vt-track .vt-tracking-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 16px; border-bottom: 1px solid #ededeb; }
#vt-track .vt-tracking-head h2 { margin: 0; color: #161719; font-family: inherit; font-size: 22px; font-weight: 700; letter-spacing: -.3px; text-transform: none; }
#vt-track #vt-tracking-number { color: #8d9198; font-size: 13px; word-break: break-all; }

/* TIMELINE */
#vt-track .vt-timeline { padding: 6px 0 2px; }
#vt-track .vt-event { position: relative; display: grid; grid-template-columns: 120px 34px minmax(0,1fr); min-height: 78px; padding: 16px 0; }
#vt-track .vt-event-date { padding-top: 1px; color: #3f4349; font-size: 13px; line-height: 1.5; }
#vt-track .vt-event-date strong { display: block; font-weight: 500; }
#vt-track .vt-event-date span { display: block; color: #81858a; }
#vt-track .vt-event-marker { position: relative; display: flex; justify-content: center; }
#vt-track .vt-event-marker:after { content: ""; position: absolute; top: 15px; bottom: -32px; left: 50%; width: 1px; transform: translateX(-50%); background: #dedfdf; }
#vt-track .vt-event:last-child .vt-event-marker:after, #vt-track .vt-event.vt-last .vt-event-marker:after { display: none; }
#vt-track .vt-event-dot { position: relative; z-index: 2; width: 10px; height: 10px; margin-top: 5px; border-radius: 50%; background: #c6c8ca; box-shadow: 0 0 0 4px #fff; }
#vt-track .vt-event:first-child .vt-event-dot { background: var(--vt-green); box-shadow: 0 0 0 4px #fff, 0 0 0 7px #e9f8ed; }
#vt-track .vt-event-content { min-width: 0; padding-left: 6px; }
#vt-track .vt-event-title { color: #17191c; font-size: 15px; font-weight: 600; line-height: 1.4; }
#vt-track .vt-event-location { display: flex; align-items: center; gap: 6px; margin-top: 5px; color: #7d8187; font-size: 13px; }
#vt-track .vt-event-location svg { width: 13px; height: 13px; flex: 0 0 13px; fill: none; stroke: currentColor; stroke-width: 1.6; }
#vt-track .vt-event-description { margin-top: 3px; color: #888d93; font-size: 9px; line-height: 1.4; }
#vt-track .vt-timeline-empty { padding: 24px 0; color: #888; font-size: 11px; }
#vt-track .vt-timeline-more { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin: 4px 0 8px; padding: 12px 0 4px; border: 0; border-top: 1px solid #ededeb; background: transparent; color: #17191c; font-size: 14px; font-weight: 600; }
#vt-track .vt-timeline-more svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
#vt-track .vt-timeline-more.open svg { transform: rotate(180deg); }

/* SUPPORT */
#vt-track .vt-support-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 18px; padding: 16px 22px; border: 1px solid #ececeb; border-radius: 14px; background: #fff; box-shadow: 0 8px 24px rgba(0,0,0,.02); }
#vt-track .vt-support-left { display: flex; align-items: center; gap: 12px; }
#vt-track .vt-support-icon { display: grid; place-items: center; width: 50px; height: 50px; flex: 0 0 50px; border-radius: 50%; background: #f3f3f2; }
#vt-track .vt-support-icon svg { width: 23px; height: 23px; fill: none; stroke: #151515; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
#vt-track .vt-support-left strong, #vt-track .vt-support-left span { display: block; }
#vt-track .vt-support-left strong { color: #17191c; font-size: 15px; font-weight: 600; }
#vt-track .vt-support-left span { margin-top: 3px; color: #8d9195; font-size: 13px; }
#vt-track .vt-support-button { display: flex; align-items: center; justify-content: center; gap: 14px; min-width: 190px; padding: 14px 22px; border-radius: 8px; background: #050505; color: #fff !important; text-decoration: none !important; font-size: 15px; font-weight: 500; }
#vt-track .vt-support-button span { font-size: 18px; }

/* LOADING */
#vt-track .vt-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 420px; text-align: center; }
#vt-track .vt-loading strong { margin-top: 4px; font-size: 13px; }
#vt-track .vt-loading small { margin-top: 5px; color: #999; font-size: 10px; }
#vt-track .vt-spinner { width: 34px; height: 34px; margin-bottom: 13px; border: 3px solid #eee; border-top-color: #222; border-radius: 50%; animation: vt-spin .8s linear infinite; }
@keyframes vt-spin { to { transform: rotate(360deg); } }

/* TABLET */
@media (max-width: 1000px) {
  #vt-track .vt-recent-list { grid-template-columns: repeat(3, minmax(0,1fr)); }
}

/* SMALL TABLET */
@media (max-width: 850px) {
  #vt-track .vt-hero { grid-template-columns: 1fr; gap: 8px; }
  #vt-track .vt-search-card { width: 100%; max-width: 520px; margin: 0 auto; }
  #vt-track .vt-visual { min-height: 240px; }
  #vt-track .vt-box { width: min(100%,380px); }
  #vt-track .vt-floating { right: 8%; }
  #vt-track .vt-benefits { grid-template-columns: 1fr; }
  #vt-track .vt-benefit { justify-content: flex-start; padding: 11px 8px; }
  #vt-track .vt-benefit + .vt-benefit { border-top: 1px solid #e5e5e3; border-left: 0; }
}

/* MOBILE */
@media (max-width: 600px) {
  #vt-track { padding: 7px 14px 32px; }
  #vt-track .vt-heading h1 { font-size: 28px; }
  #vt-track .vt-search-card { padding: 18px; }
  #vt-track .vt-visual { min-height: 210px; }
  #vt-track .vt-box { width: 310px; max-width: 100%; }
  #vt-track .vt-floating { top: 1px; right: 0; padding: 7px 9px; }
  #vt-track .vt-recent-list { grid-template-columns: repeat(2,minmax(0,1fr)); }
  #vt-track .vt-result-screen { padding-top: 0; }
  #vt-track .vt-back { margin-bottom: 12px; }
  #vt-track .vt-result-hero { padding-bottom: 21px; }
  #vt-track .vt-result-status-icon { position: static; transform: none; margin: 0 auto 10px; width: 54px; height: 54px; flex-basis: 54px; }
  #vt-track .vt-result-status-icon svg { width: 26px; height: 26px; }
  #vt-track .vt-result-status-copy h1 { font-size: 29px; letter-spacing: -1px; }
  #vt-track .vt-result-status-copy p { font-size: 13px; }
  #vt-track .vt-order-progress { padding: 0; margin-bottom: 24px; }
  #vt-track .vt-progress-circle { width: 30px; height: 30px; flex-basis: 30px; }
  #vt-track .vt-progress-circle svg { width: 15px; height: 15px; }
  #vt-track .vt-progress-line { left: calc(50% + 19px); width: calc(100% - 38px); }
  #vt-track .vt-progress-label strong { font-size: 11px; }
  #vt-track .vt-progress-label span { font-size: 10px; }
  #vt-track .vt-tracking-card { padding: 17px 14px 5px; }
  #vt-track .vt-tracking-head { align-items: flex-start; flex-direction: column; gap: 6px; }
  #vt-track .vt-tracking-head h2 { font-size: 18px; }
  #vt-track .vt-event { grid-template-columns: 84px 26px minmax(0,1fr); min-height: 78px; }
  #vt-track .vt-event-date { font-size: 11px; }
  #vt-track .vt-event-content { padding-left: 3px; }
  #vt-track .vt-event-title { font-size: 13px; }
  #vt-track .vt-event-location, #vt-track .vt-event-description { font-size: 11px; }
  #vt-track .vt-back, #vt-track .vt-order-reference { font-size: 13px; }
  #vt-track .vt-support-card { align-items: stretch; flex-direction: column; }
  #vt-track .vt-support-button { width: 100%; }
}
</style>

<script>
(function () {
  var TRACK_API = "https://lojas-one.vercel.app/api/public/track";
  var RECENT_API = "https://lojas-one.vercel.app/api/public/recent-deliveries";

  var $ = function (id) { return document.getElementById(id); };
  var searchScreen = $("vt-search-screen");
  var resultScreen = $("vt-result-screen");
  var loading = $("vt-loading");
  var errorBox = $("vt-error");
  var codeInput = $("vt-code");
  var orderInput = $("vt-order");
  var contactInput = $("vt-contact");

  // Status da API → título e etapa (1 Order Placed · 2 In Transit · 3 Out for Delivery · 4 Delivered).
  var STATUS = {
    NotFound: { label: "Order Placed", step: 1 },
    InfoReceived: { label: "Order Placed", step: 1 },
    InTransit: { label: "In Transit", step: 2 },
    Exception: { label: "In Transit", step: 2 },
    Expired: { label: "In Transit", step: 2 },
    AvailableForPickup: { label: "Ready for Pickup", step: 3 },
    OutForDelivery: { label: "Out for Delivery", step: 3 },
    DeliveryFailure: { label: "Delivery Attempted", step: 3 },
    Delivered: { label: "Delivered", step: 4 }
  };
  var SUBTITLE = {
    Delivered: "Your order has been delivered.",
    OutForDelivery: "Your order is on the way and will be delivered soon.",
    AvailableForPickup: "Your order is ready for pickup.",
    DeliveryFailure: "A delivery attempt was made.",
    InfoReceived: "Your order has been prepared for shipment.",
    NotFound: "Your order has been prepared for shipment."
  };

  function esc(value) {
    var el = document.createElement("div");
    el.textContent = value === null || value === undefined ? "" : String(value);
    return el.innerHTML;
  }
  function validDate(v) { var d = v ? new Date(v) : null; return d && !isNaN(d.getTime()) ? d : null; }
  function shortDate(v) { var d = validDate(v); return d ? d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : ""; }
  function timeOf(v) { var d = validDate(v); return d ? d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" }) : ""; }
  // Previsão vem como dia ("2026-10-14"): mostra o dia como está, sem mexer no fuso.
  function eddDay(v) {
    var m = v && String(v).match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!m) return "";
    return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], 12)).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", timeZone: "UTC" });
  }
  function relativeTime(v) {
    var d = validDate(v); if (!d) return "";
    var min = Math.floor((Date.now() - d.getTime()) / 60000);
    if (min < 1) return "just now";
    if (min < 60) return min + " min ago";
    var h = Math.floor(min / 60);
    if (h < 24) return h === 1 ? "1 hour ago" : h + " hours ago";
    var days = Math.floor(h / 24);
    return days === 1 ? "1 day ago" : days + " days ago";
  }

  function showError(msg) { errorBox.textContent = msg; errorBox.style.display = "block"; }
  function clearError() { errorBox.textContent = ""; errorBox.style.display = "none"; }
  function showLoading() { clearError(); searchScreen.hidden = true; resultScreen.hidden = true; loading.hidden = false; }
  function backToSearch(msg) {
    loading.hidden = true; resultScreen.hidden = true; searchScreen.hidden = false;
    if (msg) showError(msg);
  }
  function showSearch() {
    backToSearch();
    if (location.search) history.replaceState(null, "", location.pathname);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  /* ===== ORDER ACCORDION ===== */
  $("vt-order-toggle").addEventListener("click", function () {
    var open = this.getAttribute("aria-expanded") === "true";
    this.setAttribute("aria-expanded", open ? "false" : "true");
    $("vt-order-panel").classList.toggle("open", !open);
  });

  /* ===== TRACK BY CODE (GET ?code=) ===== */
  function trackCode(code) {
    code = String(code || codeInput.value || "").replace(/\s+/g, "");
    if (code.length < 5) { showError("Please enter your tracking number."); return; }
    codeInput.value = code;
    showLoading();
    fetch(TRACK_API + "?code=" + encodeURIComponent(code), { headers: { Accept: "application/json" } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.tracking) {
          backToSearch("We couldn't find this tracking number. It can take up to 48 hours after your order ships for tracking to become available.");
          return;
        }
        render(data.tracking);
        history.replaceState(null, "", location.pathname + "?nums=" + encodeURIComponent(code));
      })
      .catch(function () { backToSearch("We couldn't load your tracking information. Please try again."); });
  }

  /* ===== TRACK BY ORDER (POST { orderNumber, contact }) ===== */
  function trackOrder() {
    var order = orderInput.value.trim();
    var contact = contactInput.value.trim();
    if (!order || !contact) { showError("Please enter your order number and email or phone number."); return; }
    showLoading();
    fetch(TRACK_API, {
      method: "POST",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify({ orderNumber: order, order: order, contact: contact })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.found) { backToSearch("We couldn't find an order with these details. Please check and try again."); return; }
        if (!data.tracking) { backToSearch("Order " + data.orderNumber + " is being prepared. You'll receive a tracking number by email as soon as it ships."); return; }
        render(data.tracking);
      })
      .catch(function () { backToSearch("We couldn't load your order. Please try again."); });
  }

  /* ===== RESULT ===== */
  function render(t) {
    var st = STATUS[t.status] || { label: "In Transit", step: 2 };

    $("vt-order-reference").textContent = t.orderNumber
      ? "Order " + (String(t.orderNumber).charAt(0) === "#" ? t.orderNumber : "#" + t.orderNumber) : "";
    $("vt-result-title").textContent = st.label;
    $("vt-result-subtitle").textContent = SUBTITLE[t.status] || "Your order is on the way.";

    // Previsão: só a oficial (a API já filtra) e nunca depois de entregue.
    var edd = $("vt-result-edd");
    var days = t.edd && t.status !== "Delivered" ? [eddDay(t.edd.from), eddDay(t.edd.to)].filter(Boolean) : [];
    if (days.length) {
      edd.innerHTML = "Estimated delivery: <b>" + esc(days.length === 2 && days[0] !== days[1] ? days[0] + " – " + days[1] : days[0]) + "</b>";
      edd.hidden = false;
    } else { edd.textContent = ""; edd.hidden = true; }

    $("vt-tracking-number").textContent = t.trackingNumber ? "Tracking: " + t.trackingNumber : "";

    setProgress(st.step, t.steps || []);
    renderTimeline(t.events || []);

    loading.hidden = true; searchScreen.hidden = true; resultScreen.hidden = false;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  // Datas das etapas vêm prontas da API (steps: Ordered, Order Ready, In Transit,
  // Out for Delivery, Delivered) — mesma regra da página: Delivered só com
  // entrega confirmada.
  function setProgress(current, steps) {
    var at = function (label) { for (var i = 0; i < steps.length; i++) if (steps[i].label === label) return steps[i].at; return null; };
    var dates = { 1: at("Ordered"), 2: at("In Transit"), 3: at("Out for Delivery"), 4: at("Delivered") };
    var items = document.querySelectorAll("#vt-track .vt-progress-item");
    for (var i = 0; i < items.length; i++) {
      var step = Number(items[i].getAttribute("data-step"));
      items[i].classList.remove("vt-done", "vt-current");
      if (step < current) items[i].classList.add("vt-done");
      else if (step === current) items[i].classList.add("vt-current");
      $("vt-step-date-" + step).textContent = step <= current ? shortDate(dates[step]) : "";
    }
  }

  // Eventos da API: { at, description, location } — mais novo primeiro. Mostra
  // os 3 mais recentes; o botão abre o resto.
  var VISIBLE_EVENTS = 3;
  var CHEVRON = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>';
  function setExpanded(open) {
    var items = document.querySelectorAll("#vt-timeline .vt-event");
    var more = $("vt-timeline-more");
    for (var i = 0; i < items.length; i++) {
      items[i].hidden = !open && i >= VISIBLE_EVENTS;
      items[i].classList.toggle("vt-last", !open && i === VISIBLE_EVENTS - 1);
    }
    more.hidden = items.length <= VISIBLE_EVENTS;
    more.classList.toggle("open", open);
    more.innerHTML = (open ? "Show less" : "Show all updates (" + items.length + ")") + CHEVRON;
  }
  $("vt-timeline-more").addEventListener("click", function () { setExpanded(!this.classList.contains("open")); });

  function renderTimeline(events) {
    var box = $("vt-timeline");
    if (!events.length) {
      box.innerHTML = '<div class="vt-timeline-empty">Tracking updates will appear here as your package moves.</div>';
      $("vt-timeline-more").hidden = true;
      return;
    }
    var pin = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>';
    box.innerHTML = events.map(function (e) {
      var date = shortDate(e.at), time = timeOf(e.at);
      return '<div class="vt-event">' +
        '<div class="vt-event-date">' + (date ? "<strong>" + esc(date) + "</strong>" : "") + (time ? "<span>" + esc(time) + "</span>" : "") + "</div>" +
        '<div class="vt-event-marker"><span class="vt-event-dot"></span></div>' +
        '<div class="vt-event-content">' +
          '<div class="vt-event-title">' + esc(e.description || "Shipment update") + "</div>" +
          (e.location ? '<div class="vt-event-location">' + pin + "<span>" + esc(e.location) + "</span></div>" : "") +
        "</div></div>";
    }).join("");
    setExpanded(false);
  }

  /* ===== RECENT DELIVERIES (só dados reais da API) ===== */
  var recent = [], recentPos = 0, rotateTimer = null;

  function renderRecent() {
    var section = $("vt-recent"), list = $("vt-recent-list");
    if (!recent.length) { section.hidden = true; return; }
    list.innerHTML = "";
    var count = Math.min(6, recent.length);
    for (var i = 0; i < count; i++) {
      var d = recent[(recentPos + i) % recent.length];
      var item = document.createElement("div");
      item.className = "vt-recent-item";
      item.innerHTML =
        '<div class="vt-recent-location"><span class="vt-state-badge">' + esc(String(d.region || "US").toUpperCase()) + "</span>" +
        '<span class="vt-recent-city">' + esc(d.city + (d.region ? ", " + d.region : "")) + "</span></div>" +
        '<div class="vt-recent-bottom"><span class="vt-recent-status">' + esc(d.status) + "</span>" +
        (d.at ? '<span class="vt-recent-time">' + esc(relativeTime(d.at)) + "</span>" : "") + "</div>";
      list.appendChild(item);
    }
    section.hidden = list.children.length === 0;
  }

  function startRotation() {
    if (rotateTimer) { clearInterval(rotateTimer); rotateTimer = null; }
    if (recent.length <= 6) return;
    rotateTimer = setInterval(function () {
      recentPos += 6;
      if (recentPos >= recent.length) recentPos = 0;
      renderRecent();
    }, 5000);
  }

  function loadRecent() {
    fetch(RECENT_API, { headers: { Accept: "application/json" } })
      .then(function (r) { if (!r.ok) throw new Error("http " + r.status); return r.json(); })
      .then(function (data) {
        var list = data && Array.isArray(data.deliveries) ? data.deliveries : [];
        recent = list.filter(function (d) { return d && d.city && d.status; });
        if (recentPos >= recent.length) recentPos = 0;
        renderRecent();
        startRotation();
      })
      .catch(function () { recent = []; $("vt-recent").hidden = true; });
  }

  /* ===== EVENTS ===== */
  $("vt-track-btn").addEventListener("click", function () { trackCode(); });
  $("vt-order-btn").addEventListener("click", trackOrder);
  $("vt-back").addEventListener("click", showSearch);
  codeInput.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); trackCode(); } });
  orderInput.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); trackOrder(); } });
  contactInput.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); trackOrder(); } });

  // Link dos e-mails: ?nums=CÓDIGO (também ?code= / ?tracking=) abre direto o resultado.
  var params = new URLSearchParams(location.search);
  var initial = params.get("nums") || params.get("code") || params.get("tracking");
  if (initial) trackCode(String(initial).split(",")[0]);

  loadRecent();
  setInterval(loadRecent, 60000);
})();
</script>
